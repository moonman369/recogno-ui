# Base URL of the Recogno worker API. No trailing slash.
# Also where the browser is sent for Google sign-in (GET /auth/google), so the
# server's configured OAuth redirect must point back at this app's origin.
VITE_API_BASE_URL=http://localhost:8787

# Legacy stub identity from before real auth, sent as x-user-id. Used only when
# there is no access token, so a worker still running the placeholder keeps
# working. Leave blank once the worker serves /auth/*.
VITE_USER_ID=
